# Client brand boot splash — animated.
# Background scaled to cover, centered logo with a soft pulse, and a rotating
# spinner ring below it. Uses only the documented Plymouth script API
# (Sprite/Image/Math/SetRefreshFunction) — no nonstandard calls.

# flip = 1 draws the whole splash turned 180 degrees, for panels whose boot
# framebuffer comes up upside down while the desktop is correct. Set by
# 06_plymouth.sh from SPLASH_ROTATE=180 — leave this line exactly as is.
flip = 0;

if (flip) {
    Window.SetBackgroundTopColor(0.16, 0.24, 0.30);
    Window.SetBackgroundBottomColor(0.29, 0.42, 0.51);
} else {
    Window.SetBackgroundTopColor(0.29, 0.42, 0.51);
    Window.SetBackgroundBottomColor(0.16, 0.24, 0.30);
}

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

# Turn an image 180 degrees when flipped (same size, so layout math holds).
fun orient(img) {
    if (flip)
        return img.Rotate(Math.Pi);
    return img;
}

# Place a sprite at its unflipped position; when flipped, mirror it through
# the screen center so the layout turns with the artwork.
fun place(sprite, x, y, w, h) {
    if (flip) {
        x = screen.w - x - w;
        y = screen.h - y - h;
    }
    sprite.SetX(x);
    sprite.SetY(y);
}

# --- Background: scale to cover, centered -----------------------------------
bg.image = Image("background.png");
if (bg.image) {
    scale_x = screen.w / bg.image.GetWidth();
    scale_y = screen.h / bg.image.GetHeight();
    if (scale_x > scale_y)
        bg.scale = scale_x;
    else
        bg.scale = scale_y;
    bg.scaled = bg.image.Scale(bg.image.GetWidth() * bg.scale,
                               bg.image.GetHeight() * bg.scale);
    bg.sprite = Sprite(orient(bg.scaled));
    place(bg.sprite,
          screen.w / 2 - bg.scaled.GetWidth() / 2,
          screen.h / 2 - bg.scaled.GetHeight() / 2,
          bg.scaled.GetWidth(), bg.scaled.GetHeight());
    bg.sprite.SetZ(-100);
}

# --- Logos: Boeing, and the Autopilot org logo beside it ----------------------
# Both centered as a pair; if autopilot.png is missing, Boeing sits alone.
logo.image = Image("logo.png");
ap.image = Image("autopilot.png");
gap = 80;
pair_w = 0;
if (logo.image) pair_w = pair_w + logo.image.GetWidth();
if (ap.image) pair_w = pair_w + ap.image.GetWidth();
if (logo.image && ap.image) pair_w = pair_w + gap;
pair_x = screen.w / 2 - pair_w / 2;
if (logo.image) {
    logo.sprite = Sprite(orient(logo.image));
    logo.x = pair_x;
    logo.y = screen.h / 2 - logo.image.GetHeight() / 2;
    place(logo.sprite, logo.x, logo.y, logo.image.GetWidth(), logo.image.GetHeight());
    logo.sprite.SetZ(10);
    pair_x = pair_x + logo.image.GetWidth() + gap;
}
if (ap.image) {
    ap.sprite = Sprite(orient(ap.image));
    ap.x = pair_x;
    ap.y = screen.h / 2 - ap.image.GetHeight() / 2;
    place(ap.sprite, ap.x, ap.y, ap.image.GetWidth(), ap.image.GetHeight());
    ap.sprite.SetZ(10);
}

# --- Spinner: pre-rotated frames, below the logo -----------------------------
spinner.frame_count = 24;
spinner.image = Image("spinner.png");
if (spinner.image) {
    for (i = 0; i < spinner.frame_count; i++)
        spinner.frame[i] = spinner.image.Rotate(i * 2 * Math.Pi / spinner.frame_count + flip * Math.Pi);
    spinner.sprite = Sprite(spinner.frame[0]);
    if (logo.image)
        spinner.y = logo.y + logo.image.GetHeight() + 40;
    else
        spinner.y = screen.h / 2 + 40;
    place(spinner.sprite, screen.w / 2 - spinner.image.GetWidth() / 2, spinner.y,
          spinner.image.GetWidth(), spinner.image.GetHeight());
    spinner.sprite.SetZ(10);
}

# --- Animation: ~50 refreshes/sec --------------------------------------------
counter = 0;
fun refresh_callback() {
    counter++;
    if (spinner.image) {
        frame = Math.Int(counter / 2) % spinner.frame_count;
        spinner.sprite.SetImage(spinner.frame[frame]);
    }
    if (logo.image) {
        # gentle pulse between 80% and 100% opacity, ~2.5 s period
        logo.sprite.SetOpacity(0.9 + 0.1 * Math.Sin(counter * 2 * Math.Pi / 125));
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- On quit, leave the logo fully opaque ------------------------------------
fun quit_callback() {
    if (logo.image)
        logo.sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_callback);
